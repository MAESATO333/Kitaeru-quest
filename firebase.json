{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "README.md",
      ".github/**",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/admin/",
        "destination": "/admin",
        "type": 301
      },
      {
        "source": "/taiken/",
        "destination": "/taiken",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/taiken",
        "destination": "/taiken.html"
      },
      {
        "source": "/admin",
        "destination": "/index.html"
      },
      {
        "source": "/blog",
        "destination": "/index.html"
      },
      {
        "source": "/photo",
        "destination": "/index.html"
      },
      {
        "source": "/board",
        "destination": "/index.html"
      },
      {
        "source": "/news",
        "destination": "/index.html"
      },
      {
        "source": "/cinema",
        "destination": "/index.html"
      },
      {
        "source": "/join",
        "destination": "/index.html"
      }
    ]
  }
}